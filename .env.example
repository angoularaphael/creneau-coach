# =============================================================================
# coach.boxingcenter.fr — caricature .env (v1)
# Copier vers .env.local (Next) / Vercel. JAMAIS committer .env / .env.production
# Cahier : docs/CAHIER-API.md
#
# Qui remplit quoi
#   Commun / Junior : app, Supabase, horloge, métier
#   Brad          : URLs publiques, Cloudinary (photos)
#   Raphael       : Payplug, PayPal, QR HMAC, mails, bot URL — PAS le MDP Deciplus ici
# Deciplus login  : uniquement BotHosting → bot/.env.example
# IMAP 2FA JUNIOR : jeremyfidge@gmail.com (DECIPLUS_IMAP_PASS = app password Gmail)
# =============================================================================

# --- App (Junior / Brad) -------------------------------------------------------
NODE_ENV=development
# Vercel refuse TZ (nom réservé). Fuseau métier = Europe/Paris en dur (FUSEAU_METIER).
# Local / BotHosting : TZ marche. Vercel : APP_TZ seulement.
APP_TZ=Europe/Paris
PORT=3041
# URL publique (cookies Secure, return_url Payplug/PayPal, liens mails).
# En production, les DEUX valent https://coachings.boxingcenter.fr : un retour de
# paiement vers une autre adresse ramène le coach déconnecté (MISE-EN-LIGNE.md §2).
SITE_URL=https://creneau-coach.vercel.app
NEXT_PUBLIC_SITE_URL=https://coachings.boxingcenter.fr
# Interrupteur d'indexation. Vide = site fermé aux moteurs (robots Disallow,
# noindex, sitemap vide). « true » seulement quand check-seo --strict passe sur
# le vrai domaine. Ignoré sur les prévisualisations Vercel.
NEXT_PUBLIC_SEO_INDEXABLE=

# --- Supabase (Junior — schéma coach_*, RLS, dossier supabase/) --------------
# Projet : zpkdveyhcmxlkhuoudfr  (clé publishable dans .env local, pas Git)
NEXT_PUBLIC_SUPABASE_URL=https://zpkdveyhcmxlkhuoudfr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias supabase-js v2 (même valeur que PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role = serveur only (API routes, cron, bot). INTERDIT au navigateur.
SUPABASE_URL=https://zpkdveyhcmxlkhuoudfr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Base Postgres directe (Junior — migrations, tests contractuels) ---------
# Utilisée par scripts/db-migrate.mjs et les tests du moteur. PAS par l'app Next,
# qui passe par supabase-js. Ne jamais pointer la production ici sans le vouloir.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/creneau_coach_dev
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5432/creneau_coach_test
# Pooler session (migrations, IPv4). Direct db.PROJECT.supabase.co = IPv6.
# DATABASE_URL_SUPABASE=postgresql://postgres.PROJECT:MDP@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Auth / cookies (Brad + Junior) ------------------------------------------
# Cookie session httpOnly — jamais de JWT navigateur
# COACH_AUTH_MOCK=1 uniquement en local SANS projet Supabase. Ignoré dès que les clés
# Supabase sont posées, et interdit en production.
SESSION_SECRET=change-me-in-production-32chars-min
# Première direction (seed, pas un mot de passe en dur en prod)
DIRECTION_EMAIL=angoularaphael05@gmail.com

# --- Porte du back-office --------------------------------------------------
# Mêmes personnes que BOXPLUS / gestion-manager : table public.app_users
# (projet ulxtbvxdueolvnjhpzvw). Lecture SEULE — on ne touche pas BOXPLUS.
# Distinct de SUPABASE_* du moteur coach.
BOXPLUS_SUPABASE_URL=https://ulxtbvxdueolvnjhpzvw.supabase.co
BOXPLUS_SUPABASE_SERVICE_ROLE_KEY=
# Optionnel : même super-admin que la boutique (hors table).
BOXPLUS_SUPER_ADMIN_EMAIL=
BOXPLUS_SUPER_ADMIN_PASSWORD=
# Si le mot de passe commence par #, dotenv/Vercel le coupent : coller aussi
# BOXPLUS_SUPER_ADMIN_PASSWORD_B64 (base64 du mot de passe, sans le coller en clair).
# BOXPLUS_SUPER_ADMIN_PASSWORD_B64=
# Poivre des hash IP d'audit (32 octets hex). Sans lui les ip_hash sont trop faibles.
AUDIT_IP_PEPPER=

# --- Métier créneaux (Junior — défauts ; le BO direction peut surcharger) ----
HOLD_TTL_SECONDS=600
MAX_ACTIVE_RESERVATIONS=3
CAPACITY_PER_SLOT=2
CANCEL_MIN_HOURS=24
QR_EARLY_MINUTES=5
OFFPEAK_CENTS=1000
PEAK_CENTS=1500

# --- Cron Vercel (Junior + Raphael) ------------------------------------------
# Header Authorization: Bearer $CRON_SECRET  sur /api/cron/*
CRON_SECRET=change-me-in-production
# Jobs : expire holds, consumed créneaux, retry/revoke Deciplus, relance signature

# --- Paiement 1× (Raphael) — PAS de 4× / Scalapay / Oney / Stripe ------------
# Portail : https://portal.payplug.com  → clés TEST sk_test_…  LIVE sk_live_…
PAYPLUG_SECRET_KEY=
# PAYPLUG_API_VERSION=2019-08-06
PAYPLUG_TEST_SECRET_KEY=
# Webhook prod : https://creneau-coach.vercel.app/api/v1/webhooks/payplug
# Mode studio (/admin → Mode studio) : checkout Payplug avec cette clé TEST.
# PAYPLUG_FORCE_TEST=1 force TEST pour tout le monde — à éviter en prod.

# PayPal (src/lib/payments/paypal.ts) — developer.paypal.com → Apps & Credentials.
# Sans CLIENT_ID + SECRET, le bouton PayPal n'est simplement pas proposé.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# live = argent réel ; toute autre valeur = bac à sable.
PAYPAL_MODE=sandbox
# Webhooks → URL https://<domaine>/api/v1/webhooks/paypal, événements
# CHECKOUT.ORDER.APPROVED et PAYMENT.CAPTURE.COMPLETED. L'identifiant du webhook
# sert à faire vérifier chaque notification PAR PayPal.
PAYPAL_WEBHOOK_ID=
# Mode studio (/admin → Mode studio) : toujours le bac à sable, jamais de repli
# sur les clés réelles.
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=
PAYPAL_TEST_WEBHOOK_ID=
PAYPAL_TEST_MODE=sandbox
# Hors production seulement : adresse d'un faux PayPal local pour les essais.
# PAYPAL_API_BASE=
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=   # seulement si SDK JS (sinon laisser vide)

# --- QR HMAC (Raphael) — secret serveur, jamais dans le PNG / le front -------
QR_HMAC_SECRET=change-me-64-hex-or-long-random

# --- Bot Deciplus (Raphael) — URL + secret, PAS le mot de passe Deciplus -----
# Header interne x-sync-secret (même valeur que le bot)
SYNC_SECRET=change-me-in-production
COACH_BOT_URL=http://prem-eu4.bot-hosting.net:20695
# Callback bot → app : POST /api/v1/internal/deciplus/callback
# Fiche Deciplus unique. Si le callback renvoie cet id, il n'est pas copie sur le coach.
DECIPLUS_SHARED_MEMBER_ID=

# --- Storage photos / PDF signés (Brad photos, Raphael PDF) ------------------
# Bucket privé. Pas d’URL publique permanente.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=coach-reservation
# Alternative : Supabase Storage (si Cloudinary off)
SUPABASE_STORAGE_BUCKET_PRIVATE=coach-private

# --- E-mails — Brevo (même canal que la boutique) -----------------------------
# Confirmation d'inscription : src/lib/mail/envoi.ts. Supabase ne fait qu'émettre
# le jeton ; il n'envoie pas l'e-mail. Les liens pointent sur SITE_URL.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=suzinabot@gmail.com
BREVO_SENDER_NAME=Boxing Center
BREVO_REPLY_TO=boxingcentertls@gmail.com
MAIL_FROM=Boxing Center <suzinabot@gmail.com>
MAIL_REPLY_TO=boxingcentertls@gmail.com

# Alertes Deciplus / webhook forgé / accès hors créneau
ALERT_EMAIL=boxingcentertls@gmail.com
ALERT_WEBHOOK_URL=

# Notifs salle (Junior émet l’event, Raphael envoie le mail)
MANAGER_EMAIL_DEFAULT=boxingcenter31@gmail.com
MANAGER_EMAIL_MINIMES=
MANAGER_EMAIL_ST_CYPRIEN=
MANAGER_EMAIL_ETATS_UNIS=
MANAGER_EMAIL_RAMONVILLE=
MANAGER_EMAIL_PORTET=
DIRECTION_NOTIFY_EMAIL=boxingcenter31@gmail.com

# --- Rate limit / sécu -------------------------------------------------------
# RATE_LIMIT_REDIS_URL=     # optionnel ; sinon mémoire process (dev only)
# CSP / HSTS gérés dans next.config — pas de secret

# --- Interdit sur Vercel (rester sur bot/.env.example) -----------------------
# DECIPLUS_USER=
# DECIPLUS_PASSWORD=
# DECIPLUS_IMAP_PASS=
