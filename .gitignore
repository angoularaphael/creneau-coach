# --- Secrets : rien d'autre que les modèles ---------------------------------
.env
.env.*
!.env.example
!bot/.env.example
!deploy/prem-eu4/.env.example

# --- Dépendances / build ----------------------------------------------------
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# --- Données locales --------------------------------------------------------
data/
*.log

# --- Documents internes : ne partent JAMAIS sur GitHub ----------------------
.research/
.claude/
.vercel/
*.bundle

# --- Système ----------------------------------------------------------------
.DS_Store
Thumbs.db

