# Bot Deciplus — accès ponctuel coachs (BotHosting UNIQUEMENT, pas Vercel)
# Lot Raphael. Cahier : ../docs/CAHIER-API.md
# 2FA : jeremyfidge@gmail.com  →  DECIPLUS_IMAP_PASS = mot de passe d’application Gmail
# Démarrage : node bootstrap.js  (panel : copier bootstrap.js → index.js)

BOT_ID=junior-coach
BOT_ROLE=coach-access
BOT_HTTP_PORT=20695
# Health public : http://prem-eu4.bot-hosting.net:20695/health
BOT_POLL_MS=5000
BOT_MAX_RETRIES=3
BOT_DATA_DIR=data
BOT_SESSION_DIR=data/session
BOT_SESSION_KEEPALIVE_MS=9000000
DECIPLUS_FAST=1
DECIPLUS_HEADLESS=true
DECIPLUS_NAV_SETTLE_MS=800

# Compte manager Deciplus (portes / membres)
DECIPLUS_URL=https://boxingcenter.deciplus.pro/
DECIPLUS_USER=JUNIOR
DECIPLUS_PASSWORD=
DECIPLUS_DEFAULT_SITE=Minimes

# IMAP Gmail — boîte du vendeur JUNIOR (codes 2FA Deciplus)
DECIPLUS_IMAP_USER=jeremyfidge@gmail.com
DECIPLUS_IMAP_PASS=
DECIPLUS_IMAP_HOST=imap.gmail.com
DECIPLUS_IMAP_PORT=993
# Après app password : npm run test:imap

# Même secret que l’app (Vercel / .env racine coach-reservation)
SYNC_SECRET=
COACH_APP_URL=https://creneau-coach.vercel.app
# Callback : $COACH_APP_URL/api/v1/internal/deciplus/callback

# Optionnel — jobs persistés côté app (Junior)
SUPABASE_URL=https://zpkdveyhcmxlkhuoudfr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

ALERT_EMAIL=boxingcentertls@gmail.com
ALERT_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=no-reply@boxingcenter.fr
RESEND_SENDER_NAME=Boxing Center
RESEND_REPLY_TO=boxingcentertls@gmail.com
TZ=Europe/Paris
