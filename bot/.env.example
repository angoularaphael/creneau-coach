# Bot Deciplus — accès ponctuel coachs
# Déployé sur BotHosting UNIQUEMENT (pas Vercel, pas .env Next).
# Lot Raphael. Cahier : ../docs/CAHIER-API.md

BOT_ID=junior-coach
BOT_ROLE=coach-access
BOT_HTTP_PORT=20695
# Health public : http://prem-eu4.bot-hosting.net:20695/health
BOT_POLL_MS=5000
BOT_MAX_RETRIES=3
BOT_DATA_DIR=data
BOT_SESSION_DIR=data/session
BOT_SESSION_KEEPALIVE_MS=9000000
DECIPLUS_FAST=1
DECIPLUS_HEADLESS=true
DECIPLUS_NAV_SETTLE_MS=800

# Compte manager Deciplus (accès portes / membres)
DECIPLUS_URL=https://boxingcenter.deciplus.pro/
DECIPLUS_USER=JUNIOR
DECIPLUS_PASSWORD=
DECIPLUS_DEFAULT_SITE=Minimes
DECIPLUS_IMAP_USER=
DECIPLUS_IMAP_PASS=
DECIPLUS_IMAP_HOST=imap.gmail.com
DECIPLUS_IMAP_PORT=993

# Même projet Supabase que l’app (jobs coach_deciplus)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Doit matcher l’app Vercel
SYNC_SECRET=change-me-in-production
COACH_APP_URL=https://coach.boxingcenter.fr
# POST jobs : $COACH_APP_URL/api/v1/internal/deciplus/jobs
# Callback   : $COACH_APP_URL/api/v1/internal/deciplus/callback

ALERT_EMAIL=boxingcentertls@gmail.com
ALERT_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=no-reply@boxingcenter.fr
RESEND_SENDER_NAME=Boxing Center
RESEND_REPLY_TO=boxingcentertls@gmail.com
TZ=Europe/Paris
